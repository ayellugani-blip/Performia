# Performia Backend — Environment Variables
# Copy this file to .env and fill in the values before running the server.

# App
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Supabase — use the anon/publishable key only (never the service_role key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here
